 //--------------------Exercise 4: Understanding Operator Precedence



   int x = 5;
   int y = 10;
   int z;


   z = x + y * 2;
   printf("Result of x + y * 2 = %d\n", z);
   // According to operator precedence, multiplication is performed before addition.
   // y * 2 is calculated first (10 * 2 = 20), then added to x (5 + 20 = 25).

   z = (x + y) * 2;
   printf("Result of (x + y) * 2 = %d\n", z);
   // The parentheses force the addition to be performed first.
   // x + y is calculated first (5 + 10 = 15), then multiplied by 2 (15 * 2 = 30).

   z = x > 3 && y < 15;
   printf("Result of x > 3 && y < 15 = %d\n", z);
   // This is a logical AND operation. Both conditions must be true for the result to be true (1).
  // x > 3 is true (5 > 3).  y < 15 is true (10 < 15). both are true

   z = !(x == 5);
   printf("Result of !(x == 5) = %d\n", z);
   // The equality operator (==) is evaluated first.
   // x == 5 is true (5 is equal to 5).

